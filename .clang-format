# Formatting is not a review topic (ADR 0001 (toolchain) B15). This file is the whole
# of the discussion; CI enforces it and nobody argues about it in a pull request.
#
# The specific values are implementation detail. They were chosen to match the sources
# already in the tree rather than to express a preference.
---
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Left

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

BreakBeforeBraces: Attach
FixNamespaceComments: true
NamespaceIndentation: None

IncludeBlocks: Regroup
SortIncludes: CaseSensitive

SpaceAfterCStyleCast: true
