# Static analysis. ADR 0001 (toolchain) B16.
#
# The check set is deliberately small. B16 says it is tuned against real code rather
# than chosen in advance, and there is no real code yet: a set chosen now would be
# either uselessly permissive or an obstacle course. It grows as the emulator does,
# and each addition is justified by something it caught.
#
# A suppressed check carries an inline justification naming why the code is correct,
# not merely that the check was noisy (B16).
---
Checks: >
  -*,
  bugprone-*,
  performance-*,
  misc-*,
  modernize-use-nullptr,
  modernize-use-override,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace

# bugprone-easily-swappable-parameters is disabled rather than suppressed per site:
# this project's functions take runs of same-typed hardware values by nature
# (u8, u8, carry), and the check would fire on nearly every ALU operation without
# identifying a single real defect.
#
# misc-non-private-member-variables-in-classes is disabled because components are
# state (ADR 0003 (ownership) rule 5), and the machine's registers are data their
# owner reads. The check argues against the ownership model rather than against a bug.

WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(core|tools|frontend)/.*'
FormatStyle: file
